# Copiez ce fichier vers .env et adaptez les valeurs

PORT=3000

# --- Base de donnees PostgreSQL (rapports CDR directs) ---
# Adaptez ces valeurs a votre instance PostgreSQL 3CX.
PG_HOST=localhost
PG_PORT=5432
PG_USER=VOTRE_UTILISATEUR_POSTGRES
PG_PASSWORD=VOTRE_MOT_DE_PASSE_POSTGRES
PG_DATABASE=cdrdb
# Mettez PG_SSL=true si votre PostgreSQL exige TLS (ex: Azure Database for PostgreSQL)
PG_SSL=false

# --- Authentification ---
# Methode Entra ID (Microsoft Identity Platform) :
# Creez une inscription d'application dans le portail Microsoft Entra (https://entra.microsoft.com)
# puis renseignez les valeurs ci-dessous.
ENTRA_TENANT_ID=VOTRE_ID_LOCATAIRE_ENTRA
ENTRA_CLIENT_ID=VOTRE_ID_APPLICATION_ENTRA
ENTRA_CLIENT_SECRET=VOTRE_SECRET_CLIENT_ENTRA
# URI de redirection a declarer dans Entra ID :
ENTRA_REDIRECT_URI=http://localhost:3000/auth/callback
# Scopes demandes (par defaut User.Read) :
ENTRA_SCOPES=User.Read

# Methode authentification locale (compte(s) utilisateur(s) en base PostgreSQL) :
# Mettez LOCAL_AUTH_ENABLED=true pour activer la connexion locale.
# Les utilisateurs sont geres dans la table cdr_users de la base PostgreSQL.
# Le premier utilisateur cree devient automatiquement administrateur.
LOCAL_AUTH_ENABLED=false

# Secret pour signer les sessions (changez impérativement en production) :
SESSION_SECRET=changez-moi-en-production-une-chaine-longue-et-aleatoire
